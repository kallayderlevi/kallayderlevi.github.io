# Public Appwrite settings used by the React frontend.
# Copy this file to .env.local before local development.
VITE_APPWRITE_ENDPOINT=https://REGION.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6aa2e15b001913bc2b82
VITE_APPWRITE_DATABASE_ID=YOUR_DATABASE_ID
VITE_APPWRITE_BOARD_TABLE_ID=YOUR_BOARD_TABLE_ID
VITE_APPWRITE_CONSULTANTS_TABLE_ID=YOUR_CONSULTANTS_TABLE_ID
VITE_APPWRITE_POSTS_TABLE_ID=YOUR_POSTS_TABLE_ID
VITE_APPWRITE_MEDIA_BUCKET_ID=YOUR_MEDIA_BUCKET_ID

# Set this only after the Appwrite Function has a public execution endpoint.
VITE_APPWRITE_FUNCTION_ENDPOINT=
